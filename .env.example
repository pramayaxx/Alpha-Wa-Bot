# DUAL AUTH: SET TO true FOR 8-DIGIT PAIRING CODE, false FOR QR CODE
USE_PAIRING_CODE=true

# REQUIRED IF USE_PAIRING_CODE=true (format: 947XXXXXXXX)
BOT_PHONE_NUMBER=94700000000

# ADMIN NUMBER FOR SPECIAL COMMANDS (format: 947XXXXXXXX)
ADMIN_NUMBER=94711111111

# DEEPSEEK API CONFIGURATION
DEEPSEEK_API_KEY=your_deepseek_api_key_here
